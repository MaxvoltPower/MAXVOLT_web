# ============================================================
# MAXVOLT — Environment Variables
# ============================================================
# This is the SINGLE env file for the whole monorepo:
#   - VITE_* variables are exposed to the React frontend (Vite)
#   - All other variables are used by the serverless backend (api/)
# ============================================================

# ---------- MongoDB ----------
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/maxvolt
MONGODB_DB=maxvolt

# ---------- Firebase Admin (Backend only — no VITE_ prefix) ----------
FIREBASE_PROJECT_ID=maxvolt-a1ceb
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@maxvolt-a1ceb.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Firebase Client (Backend /api/config reads these) ----------
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=maxvolt-a1ceb.firebaseapp.com
FIREBASE_STORAGE_BUCKET=maxvolt-a1ceb.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=117152539614
FIREBASE_APP_ID=1:117152539614:web:bd54a688c8d4fcc320334f

# ---------- Firebase Client (Frontend — Vite) ----------
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=maxvolt-a1ceb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=maxvolt-a1ceb
VITE_FIREBASE_STORAGE_BUCKET=maxvolt-a1ceb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=117152539614
VITE_FIREBASE_APP_ID=1:117152539614:web:bd54a688c8d4fcc320334f

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=webhook_secret_here
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ---------- Admin ----------
ADMIN_EMAILS=admin@maxvolt.in,owner@maxvolt.in

# ---------- Contact (Frontend — Vite) ----------
VITE_WHATSAPP_NUMBER=917595941311
VITE_CONTACT_EMAIL=maxvolt.power@gmail.com
VITE_CONTACT_PHONE=+91 7595941311

# ---------- Chatbot ----------
GROQ_API_KEY=gsk_...

# ---------- API Base URL ----------
# Leave blank so the frontend hits /api on the same origin (recommended).
# Only set this if your backend is on a different domain.
VITE_API_BASE_URL=

# ---------- Site ----------
SITE_URL=https://maxvolt-web.vercel.app