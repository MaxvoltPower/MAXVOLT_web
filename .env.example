# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/maxvolt?retryWrites=true&w=majority
MONGODB_DB=maxvolt

# Firebase Admin (Service Account)
FIREBASE_PROJECT_ID=maxvolt-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@maxvolt-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Client (exposed to frontend - use NEXT_PUBLIC_ prefix or serve via /api/config)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=maxvolt-app.firebaseapp.com
FIREBASE_STORAGE_BUCKET=maxvolt-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=webhook_secret_here

# Admin
ADMIN_EMAILS=admin@maxvolt.in,owner@maxvolt.in

# Site
SITE_URL=https://maxvolt-web.vercel.app