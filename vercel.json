{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "api"
    }
  },
  "redirects": [
    { "source": "/products/home-inverter-batteries.html", "destination": "/products?category=homeInverterBatteries", "permanent": true },
    { "source": "/products/car-batteries.html", "destination": "/products?category=carBatteries", "permanent": true },
    { "source": "/products/toto-erickshaw.html", "destination": "/products?category=totoErickshawBatteries", "permanent": true },
    { "source": "/products/ebike-batteries.html", "destination": "/products?category=ebikeBatteries", "permanent": true },
    { "source": "/products/ups.html", "destination": "/products?category=ups", "permanent": true },
    { "source": "/product-detail.html", "destination": "/products", "permanent": true },
    { "source": "/cart.html", "destination": "/cart", "permanent": true },
    { "source": "/checkout.html", "destination": "/checkout", "permanent": true },
    { "source": "/order-success.html", "destination": "/order-success", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms-conditions.html", "destination": "/terms-conditions", "permanent": true },
    { "source": "/solutions.html", "destination": "/solutions", "permanent": true },
    { "source": "/calculator.html", "destination": "/calculator", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/account/:page.html", "destination": "/account/:page", "permanent": true },
    { "source": "/admin/:page.html", "destination": "/admin/:page", "permanent": true },
    { "source": "/admin/index.html", "destination": "/admin", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/admin?path=:path*" },
    { "source": "/api/auth/:path*", "destination": "/api/auth?path=:path*" },
    { "source": "/api/products/:path*", "destination": "/api/products?path=:path*" },
    { "source": "/api/orders/:path*", "destination": "/api/orders?path=:path*" },
    { "source": "/api/payments/:path*", "destination": "/api/payments?path=:path*" },
    { "source": "/api/quotes/:path*", "destination": "/api/quotes?path=:path*" },
    { "source": "/api/reviews/:path*", "destination": "/api/reviews?path=:path*" },
    { "source": "/api/sections/:path*", "destination": "/api/sections?path=:path*" },
    { "source": "/api/categories/:path*", "destination": "/api/categories?path=:path*" },
    { "source": "/api/contact/:path*", "destination": "/api/contact?path=:path*" },
    { "source": "/api/chat/:path*", "destination": "/api/chat?path=:path*" },
    { "source": "/api/config/:path*", "destination": "/api/config?path=:path*" },
    { "source": "/api/webhook/:path*", "destination": "/api/webhook?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index" }
  ],
  "trailingSlash": false
}